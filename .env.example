# Palmprint Research Platform - Environment Configuration
# Copy this file to .env and update values for your environment

# Application
ENVIRONMENT=development
APP_NAME="Palmprint Research Platform"
VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database
# For local development with SQLite:
DATABASE_URL=sqlite:///./data/palmprint.db
# For production with PostgreSQL (both URL spellings are accepted):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/palmprint
AUTO_MIGRATE=true

# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
# For S3-compatible storage (optional):
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_USE_PATH_STYLE=true

# Upload limits
MAX_UPLOAD_BYTES=12582912  # 12MB
MAX_IMAGE_PIXELS=40000000
RETENTION_DAYS=30

# Security
AUTH_ENABLED=false
SECRET_KEY=change-me-in-production-use-a-strong-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=720
# "*" is only honoured while AUTH_ENABLED=false.  With authentication enabled
# list the exact frontend origins, comma separated.
ALLOWED_ORIGINS=*
ALLOW_CREDENTIALS=true
DEMO_MODE=true
# Set to false after provisioning accounts to disable public registration.
ALLOW_REGISTRATION=true

# ML Service
# Local development: http://localhost:8001
# Render deployment: https://palmprint-recognition-1.onrender.com
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=120.0
ML_SERVICE_API_KEY=

# Datasets
DATASET_ROOT=./data/datasets

# Frontend (build-time; only variables prefixed with VITE_ are exposed)
# Local development uses the Vite proxy:
VITE_API_BASE_URL=/api/v1
# Separate frontend deployment:
# VITE_API_BASE_URL=https://palmprint-recognition.onrender.com/api/v1

{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://palmprint-recognition.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://palmprint-recognition.onrender.com/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://palmprint-recognition.onrender.com/health"
    },
    {
      "source": "/ready",
      "destination": "https://palmprint-recognition.onrender.com/ready"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}

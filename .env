ENVIRONMENT=development
APP_NAME=Palmprint Research Platform
VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/palmprint.db
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_PIXELS=40000000
RETENTION_DAYS=30
AUTH_ENABLED=false
SECRET_KEY=change-me-in-production-use-a-strong-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOWED_ORIGINS=*
ALLOW_CREDENTIALS=true
DEMO_MODE=true
ALLOW_REGISTRATION=true
ML_SERVICE_URL=https://palmprint-recognition-1.onrender.com
ML_SERVICE_TIMEOUT=120.0
ML_SERVICE_API_KEY=
DATASET_ROOT=./data/datasets
AUTO_MIGRATE=true
VITE_API_BASE_URL=https://palmprint-recognition.onrender.com/api/v1


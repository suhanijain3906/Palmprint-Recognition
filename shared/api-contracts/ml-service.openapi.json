  "info": {
    "description": "Computer vision and machine learning microservice for the Palmprint Research Platform.\n\nThis service implements classical, documented image processing pipelines. It ships **without trained biometric weights**; every recognition response states whether a trained model was used.",
    "title": "Palmprint ML Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/algorithms": {
      "get": {
        "description": "Describe every algorithm the service can run and its limitations.",

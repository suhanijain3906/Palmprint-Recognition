      "EvaluationRequest": {
        "description": "Labelled comparison scores for a genuine/impostor evaluation.",
        "example": {
          "labels": [
            1,
            0,
            1,
            0
          ],
          "scores": [
            0.82,
            0.31,
            0.74,
            0.12
